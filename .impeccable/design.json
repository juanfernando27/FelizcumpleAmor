  "narrative": {
    "northStar": "Una caja de recuerdos",
    "overview": "Vino profundo, papel cálido y fotografías personales. Bodoni Moda da aire a los titulares; Manrope sostiene la lectura; Caveat convierte los pies de foto y las firmas en anotaciones cercanas. Los objetos de papel, pequeños giros y sombras suaves aportan una sensación de álbum que se puede tocar.\n\nEl diseño alterna superficies oscuras y claras sin perder su calidez. La fotografía y las palabras personales llevan el protagonismo; los controles acompañan su exploración.",
    "keyCharacteristics": [
      "Material de carta y fotografía.",
      "Titulares editoriales y anotaciones manuscritas.",
      "Acciones redondeadas y lectura espaciosa.",
      "Teclado, tacto y movimiento reducido."
    ],
    "rules": [
      {
        "name": "La regla del papel",
        "body": "Cada cambio de superficie lleva su pareja de texto: papel/tinta o vino/papel.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do conservar las parejas de superficie y texto.",
      "Do reservar Caveat para anotaciones y frases breves.",
      "Do verificar los tres cambios de ancho documentados.",
      "Do conservar foco visible y movimiento reducido.",
      "Do mantener visible la aclaración de imagen generada."
    ],
    "donts": [
      "Don't convertir la galería en tarjetas repetidas.",
      "Don't aplicar hover persistente en tacto.",
      "Don't animar todo el contenido.",
      "Don't usar las rampas auxiliares como nuevos colores aprobados."
    ]
  }
